# Copia este archivo a .env para `npm run dev` (no se sube a GitHub).
# En el sitio publicado, estas mismas variables se cargan en Netlify:
# Site configuration > Environment variables.

# Correo (Resend). Sin RESEND_API_KEY los casos igual se guardan, pero no se envían correos.
RESEND_API_KEY=
# Quién envía. Con dominio verificado: "Soluciones2EAM <cotizaciones@tudominio.com>".
# Si lo dejas vacío se usa onboarding@resend.dev (solo envía al correo de tu cuenta de Resend).
EMAIL_FROM=
# Correo del negocio que recibe el aviso de cada solicitud nueva.
NOTIFY_EMAIL=
# Cambia a true solo cuando EMAIL_FROM use un dominio verificado.
CONFIRM_TO_CUSTOMER=false

# Clave larga para el panel /admin. Genera una con:
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=
